#!/bin/zsh
# memwatch v4.1 — btop-style braille memory monitor (Shadow, 2026-10-21)
#
#   v4.1 changes:
#   - 256-colour value ramps: chart + bar colour is a continuous
#     red→amber→green gradient mapped from the value (v/10 index), not 3
#     flat tiers. Bars get a btop-style gradient fill: dark shade → bright
#     tip along the bar length, bold last cell.
#   - Braille graphs go two-edge: each cell spans prev→current sample
#     (left dot column = prev height, right = current), so transitions
#     land on single dots — real peaks, 2× horizontal resolution, btop look.
#   - Charts framed with dim box-drawing (│ left rail, ╰─── base rule).
#   - History: MW_ASCII=1 → ASCII sparkline fallback. MW_COLS=n force width.
#   - v4 history: braille emitted as RAW UTF-8 BYTES (zsh printf "\uXXXX"
#     fails under non-UTF-8 locales: "character not in range" — that was the
#     v2 "?" bug, not the phone font). Width from stty (tput lies in tmux).
#   - TOP: phys_footprint (Activity-Monitor Memory) alongside RSS, sorted by
#     footprint, top-N fills the screen.

INTERVAL=2

typeset -a histP histS
histP=() histS=()

R=$'\e[0m'; BL=$'\e[1m'
C_DIM=$'\e[38;5;243m'; C_TXT=$'\e[38;5;252m'; C_ACC=$'\e[38;5;51m'
C_BARBG=$'\e[38;5;238m'
SKCH=('.' '.' ':' '-' '=' '+' '*' '#')   # ASCII fallback ramp

# locale-proof braille table: BRAILLE[bits+1] = raw UTF-8 bytes of U+2800+bits
typeset -a BRAILLE
for ((b = 0; b < 256; b++)); do
  eval "BRAILLE[b+1]=\$'\\xe2\\x$(printf %02x $((0xa0 | b >> 6)))\\x$(printf %02x $((0x80 | b & 0x3f)))'"
done
# dot columns per band row k=1..4 BOTTOM→TOP: left dots (7,3,2,1), right (8,6,5,4)
LBIT=(64 4 2 1); RBIT=(128 32 16 8); PAIR=(192 36 18 9)

# value ramps: index = v/10 (0..10). pressure plots free %, swap used %.
RP_RAW=(196 196 202 208 214 220 190 118 82 46 46)
RS_RAW=(46 46 82 118 190 220 214 208 202 196 196)
typeset -a RAMP_P RAMP_S
for ((i = 0; i <= 10; i++)); do
  RAMP_P[i+1]=$'\e[38;5;'"$((RP_RAW[i+1]))"'m'
  RAMP_S[i+1]=$'\e[38;5;'"$((RS_RAW[i+1]))"'m'
done
# bar gradient ladders, dark → bright (5 stops), pre-baked SGR strings
GR_G=(22 28 34 40 46); GR_Y=(58 100 136 178 220); GR_R=(52 88 124 160 196)
typeset -a LAD_G LAD_Y LAD_R
for ((i = 1; i <= 5; i++)); do
  LAD_G[i]=$'\e[38;5;'"$((GR_G[i]))"'m'
  LAD_Y[i]=$'\e[38;5;'"$((GR_Y[i]))"'m'
  LAD_R[i]=$'\e[38;5;'"$((GR_R[i]))"'m'
done

rampcol() { # $1=value 0-100, $2=RAMP array name -> SGR on stdout
  local i=$(( $1 / 10 )); ((i < 0)) && i=0; ((i > 10)) && i=10
  eval "print -r -- \"\${$2[i+1]}\""
}
ladderfor() { # $1=value, $2=mode(P/S) -> ladder array name on stdout
  if [[ $2 == P ]]; then
    (( $1 < 10 )) && { print -r -- LAD_R; return; }
    (( $1 < 25 )) && { print -r -- LAD_Y; return; }
    print -r -- LAD_G
  else
    (( $1 > 80 )) && { print -r -- LAD_R; return; }
    (( $1 > 55 )) && { print -r -- LAD_Y; return; }
    print -r -- LAD_G
  fi
}

rep() { REP=""; local i; for ((i = 0; i < $2; i++)); do REP+=$1; done }

framed() { # $1 = multi-line chart content -> FRAMED (dim rail on every line)
  FRAMED=""
  local row
  while IFS= read -r row; do FRAMED+=" ${C_DIM}│${R}${row}"$'\n'; done <<< "$1"
}

bar() { # $1 fill% (0-100), $2=value, $3=mode, $4=len -> global BARSTR
  local f=${1:-0}; local n=${4:-16}
  [[ "$f" == <-> ]] || f=0
  (( f < 0 )) && f=0; (( f > 100 )) && f=100
  local fr=$(( (f * n + 50) / 100 )); ((fr > n)) && fr=n
  local e=$(( n - fr ))
  local lad; eval "lad=(\"\${(@)$(ladderfor $2 $3)}\")"
  BARSTR=""
  local i
  for ((i = 1; i <= fr; i++)); do
    local li=$(( 1 + (i - 1) * 4 / (fr > 1 ? fr - 1 : 1) ))
    if ((i == fr)); then
      BARSTR+="${lad[li]}${BL}█"
    else
      BARSTR+="${lad[li]}█"
    fi
  done
  BARSTR+=$R
  if ((e > 0)); then rep '░' $e; BARSTR+="${C_BARBG}${REP}${R}"; fi
}

chart() { # $1=array $2=mode(P/S) $3=rows $4=width -> CHART ($3 lines)
  local -a s; eval "s=(\"\${(@)$1}\")"
  local mode=$2 rows=$3 width=$4
  local n=${#s}
  if (( n > width )); then s=("${s[-width,-1]}"); n=$width; fi
  local off=$((width - n)); ((off < 0)) && off=0
  local T=$((rows * 4)) T2=$((rows - 1))
  local c v0 v1 h0 h1 fill f bits k kl kr r
  local line run runcol col
  CHART=""
  for ((r = 0; r < rows; r++)); do
    line=""
    if ((off > 0)); then rep ' ' $off; line=$REP; fi
    run=""; runcol=""
    for ((c = off + 1; c <= width; c++)); do
      local ci=$((c - off))
      v1=${s[ci]:-0}
      v0=${s[ci > 1 ? ci - 1 : 1]:-0}
      fill=$(( (v1 * T + 50) / 100 )); (( v1 > 0 && fill < 1 )) && fill=1
      h1=$fill
      h0=$(( (v0 * T + 50) / 100 ))
      (( v0 > 0 && h0 < 1 )) && h0=1
      bits=0
      local bb=$(( (T2 - r) * 4 ))
      for ((k = 1; k <= 4; k++)); do
        kl=0; kr=0
        (( bb + k <= h0 )) && kl=1
        (( bb + k <= h1 )) && kr=1
        if ((kl && kr)); then bits=$((bits + PAIR[k]))
        elif ((kl)); then bits=$((bits + LBIT[k]))
        elif ((kr)); then bits=$((bits + RBIT[k])); fi
      done
      col=$(rampcol $v1 $([[ $mode == P ]] && print RAMP_P || print RAMP_S))
      if [[ -n "$runcol" && "$col" != "$runcol" ]]; then
        line+="${runcol}${run}${R}"; run=""
      fi
      run+="${BRAILLE[bits+1]}"; runcol=$col
    done
    [[ -n "$run" ]] && line+="${runcol}${run}${R}"
    CHART+="${line}"$'\n'
  done
}

sparkline() { # ASCII fallback: $1=array name, $2=mode, $3=cells
  local -a s; eval "s=(\"\${(@)$1}\")"
  local mode=$2 need=$3
  local n=${#s}
  local off=$((need - n)); ((off < 0)) && off=0
  local out="" i idx v
  for ((i = 0; i < need; i++)); do
    if ((i < off)); then out+=" "; continue; fi
    idx=$((i - off + 1)); v=${s[idx]}
    out+="$(rampcol $v $([[ $mode == P ]] && print RAMP_P || print RAMP_S))${SKCH[$((v * 7 / 100 + 1))]}"
  done
  CHART="${out}"$'\n'
}

while true; do
  read -r LINES COLS <<< "$(stty size 2>/dev/null)"
  [[ -z "$COLS" || "$COLS" -lt 40 ]] && COLS=56
  [[ -z "$LINES" ]] && LINES=24
  [ -n "$MW_COLS" ] && COLS=$MW_COLS
  CW=$((COLS - 2))
  chartw=$((CW - 2))   # framed charts: │ + content must end where gauges end

  pf=$(memory_pressure -Q 2>/dev/null | grep -oE '[0-9]+%' | tail -1 | tr -d '%')
  [[ "$pf" == <-> ]] || pf=50

  sf=0; swaplab="none"
  read -r sf swaplab <<< "$(sysctl -n vm.swapusage 2>/dev/null | awk '
    { for (i = 1; i < NF; i++) { if ($i == "total") t = $(i+2); if ($i == "used") u = $(i+2) } }
    END {
      gsub("M", "", t); gsub("M", "", u)
      if (t+0 <= 0) { printf "0 none"; exit }
      p = (u+0) * 100 / (t+0); if (p > 100) p = 100
      printf "%d %.1f/%.1fG", p, (u+0)/1024, (t+0)/1024
    }')"
  [[ "$sf" == <-> ]] || sf=0

  histP+=($pf); histS+=($sf)
  while (( ${#histP} > chartw )); do histP=(${histP[2,-1]}); histS=(${histS[2,-1]}); done

  # display EMA (light smoothing for the CHARTS only; gauge/min/max/avg stay
  # raw). kernel free-memory jitter sawtooths between samples — even a
  # correct plot looks like chaos without it. MW_SMOOTH=0 disables.
  if [[ "$MW_SMOOTH" != 0 ]]; then
    shP=(); prev=-1
    for v in "${(@)histP}"; do
      (( prev < 0 )) && shP+=($v) || shP+=($(( (v + prev) / 2 )))
      prev=${shP[-1]}
    done
    shS=(); prev=-1
    for v in "${(@)histS}"; do
      (( prev < 0 )) && shS+=($v) || shS+=($(( (v + prev) / 2 )))
      prev=${shS[-1]}
    done
  else
    shP=("${(@)histP}"); shS=("${(@)histS}")
  fi

  mn=100 mx=0 sm=0 c=0
  for v in "${(@)histP}"; do ((v<mn))&&mn=$v; ((v>mx))&&mx=$v; sm=$((sm+v)); c=$((c+1)); done
  av=$(( c > 0 ? sm / c : 50 ))
  smin=100 smax=0
  for v in "${(@)histS}"; do ((v<smin))&&smin=$v; ((v>smax))&&smax=$v; done

  winsec=$(( ${#histP} * INTERVAL ))
  la=$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | xargs)
  now=$(date '+%a %d %b %H:%M:%S')

  barlen=$((COLS - 40)); ((barlen < 8)) && barlen=8; ((barlen > 36)) && barlen=36
  bar "$((100 - pf))" "$pf" P "$barlen"; pbar=$BARSTR
  bar "$sf" "$sf" S "$barlen";          sbar=$BARSTR

  P_ROWS=4 S_ROWS=2
  ((LINES < 21)) && { P_ROWS=3; S_ROWS=2 }
  ((LINES < 18)) && { P_ROWS=2; S_ROWS=1 }

  if [[ "$MW_ASCII" == 1 ]]; then
    sparkline shP P "$chartw"; chartP=${CHART%$'\n'}
    sparkline shS S "$chartw"; chartS=${CHART%$'\n'}
  else
    chart shP P "$P_ROWS" "$chartw"; chartP=${CHART%$'\n'}
    chart shS S "$S_ROWS" "$chartw"; chartS=${CHART%$'\n'}
  fi

  rl=$((COLS - 12 - ${#now} - 2)); ((rl < 0)) && rl=0
  rep '─' $rl; RULE=$REP
  rep '─' $chartw; HRULE=$REP

  out=$'\e[H\e[2J'
  out+=" ${C_ACC}${BL}◆ MEMORY${R} ${C_DIM}${RULE}${R} ${now}"$'\n'$'\n'
  out+=" ${C_TXT}${BL}$(printf '%-9s' PRESSURE)${R} $(rampcol $pf RAMP_P)${BL}$(printf '%-11s' "${pf}% free")${R} [${pbar}] ${C_DIM}${mn}-${mx} avg ${av}${R}"$'\n'
  if [[ "$MW_ASCII" == 1 ]]; then
    out+=" $chartP"$'\n'
  else
    framed "$chartP"; out+="$FRAMED"
    out+=" ${C_DIM}╰${HRULE}${R}"$'\n'
  fi
  out+=" ${C_TXT}${BL}$(printf '%-9s' SWAP)${R} $(rampcol $sf RAMP_S)${BL}$(printf '%-11s' "$swaplab")${R} [${sbar}] ${C_DIM}${smin}-${smax}%${R}"$'\n'
  if [[ "$MW_ASCII" == 1 ]]; then
    out+=" $chartS"$'\n'
  else
    framed "$chartS"; out+="$FRAMED"
    out+=" ${C_DIM}╰${HRULE}${R}"$'\n'
  fi
  out+=" ${C_DIM}last ${winsec}s · 2s/sample · load ${la}${R}"$'\n'
  out+=" ${C_DIM}pressure = free % · swap = used % · MW_ASCII=1 = ascii${R}"$'\n'$'\n'

  # TOP: fill remaining screen with top-N processes by phys_footprint (total),
  # showing RSS alongside. footprint = Activity Monitor's Memory column —
  # catches big-foots whose RSS lies (e.g. GPU/wired dirty pages in swap).
  TOP_N=$((LINES - 12 - P_ROWS - S_ROWS)); ((TOP_N < 5)) && TOP_N=5

  typeset -A PRSS PNAME
  PRSS=() PNAME=()
  while IFS='|' read -r pid rss nm; do
    [[ -z "$pid" ]] && continue
    PRSS[$pid]=$rss; PNAME[$pid]=$nm
  done <<< "$(ps axo pid=,rss=,comm= 2>/dev/null | awk '{pid=$1;rss=$2;n=$0;sub(/^[^ ]+ +[^ ]+ +/,"",n); sub(/^.*\//,"",n); sub(/^-/,"",n); if(length(n)>34)n=substr(n,1,34); printf "%s|%s|%s\n",pid,rss,n}')"

  out+=" ${C_DIM}${BL}TOP PROCESSES${R} ${C_DIM}RSS / total footprint${R}"$'\n'
  out+=" ${C_DIM}  #    RSS  TOTAL${R}"$'\n'

  i=1
  while IFS=' ' read -r pid tot; do
    [[ -z "$pid" ]] && continue
    nm=${PNAME[$pid]:-}; [[ -z "$nm" ]] && continue
    r=${PRSS[$pid]:-0}
    if (( r > 1048576 )); then rs=$(printf '%.1fG' $((r / 1048576.0))); else rs=$(printf '%.0fM' $((r / 1024.0))); fi
    out+=" $(printf '%2d' $i) ${C_DIM}$(printf '%6s' $rs)${R} ${C_ACC}$(printf '%6s' $tot)${R}  ${C_TXT}${nm}${R}"$'\n'
    i=$((i + 1)); ((i > TOP_N)) && break
  done <<< "$(top -l 1 -o mem -n 40 -stats pid,mem 2>/dev/null | awk '/^PID/{f=1;next} f && NF>=2 && $1 ~ /^[0-9]+$/ {print $1, $2}')"

  # never end with a newline: writing LINES complete lines in an LINES-row
  # pane scrolls the title off (this ate the header at phone widths)
  printf '%s' "${out%$'\n'}"
  sleep $INTERVAL
done
