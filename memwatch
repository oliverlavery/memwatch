#!/bin/zsh
# memwatch v5 — btop-style braille memory monitor (Shadow, 2026-10-21)
#
#   v5 changes (Oliver phone-feedback):
#   - PRESSURE now means what it says: gauge + chart plot USED %
#     (100 - free), so height/fill grows with actual pressure.
#   - One shared colour ramp for both rows: colour = used level,
#     green→amber→red, so gauge and time-series always agree.
#   - Label still shows "% free" (preference), just no longer drives
#     the visuals.
#   - v4.1 kept: 256-colour value ramps, two-edge braille (prev→cur per
#     cell, 2× resolution), dim framing, MW_ASCII=1 fallback, MW_COLS=n
#     force width, MW_SMOOTH=0 disables EMA chart smoothing.
#   - Braille emitted as RAW UTF-8 bytes (zsh printf "\uXXXX" breaks under
#     non-UTF-8 locales). Width from stty (tput lies in tmux).
#   - TOP: phys_footprint alongside RSS, sorted by footprint.

INTERVAL=2
GWLOG=/Users/oliver/Library/Logs/openclaw/gateway.log
INFMAP=~/.cache/memwatch-infer.map
TSMAP=~/.cache/memwatch-tstart.map
OCSNAP=/tmp/mw-oc-sessions.json

typeset -a histP histS
histP=() histS=()

R=$'\e[0m'; BL=$'\e[1m'
C_DIM=$'\e[38;5;243m'; C_TXT=$'\e[38;5;252m'; C_ACC=$'\e[38;5;51m'
C_BARBG=$'\e[38;5;238m'
SKCH=('.' '.' ':' '-' '=' '+' '*' '#')   # ASCII fallback ramp

# locale-proof braille table: BRAILLE[bits+1] = raw UTF-8 bytes of U+2800+bits
typeset -a BRAILLE
for ((b = 0; b < 256; b++)); do
  eval "BRAILLE[b+1]=\$'\\xe2\\x$(printf %02x $((0xa0 | b >> 6)))\\x$(printf %02x $((0x80 | b & 0x3f)))'"
done
# dot columns per band row k=1..4 BOTTOM→TOP: left dots (7,3,2,1), right (8,6,5,4)
LBIT=(64 4 2 1); RBIT=(128 32 16 8); PAIR=(192 36 18 9)

# single shared ramp, indexed by USED level 0-100 (v/10): green→amber→red.
# Both PRESSURE and SWAP now plot used %, so one ramp serves both rows and
# the gauge bar + its chart can never disagree on colour.
RAMP_RAW=(46 46 82 118 190 220 214 208 202 196 196)
typeset -a RAMP
for ((i = 0; i <= 10; i++)); do
  RAMP[i+1]=$'\e[38;5;'"$((RAMP_RAW[i+1]))"'m'
done
# extended ramp: 101 levels. Interpolate the anchors in RGB space and snap
to the nearest xterm 256-cube colour — interpolating PALETTE INDICES walks
# the colour cube through maroon/blue/purple (46→82 passes 53=maroon,
# 57=blue), which is exactly the rainbow-bar bug. Components are on the
# 0-5 cube scale; rounding keeps us on valid cube colours.
typeset -a APR APG APB RAMPX
for ((i = 0; i <= 10; i++)); do
  n=$(( RAMP_RAW[i+1] - 16 ))
  APR[i+1]=$(( n / 36 )); APG[i+1]=$(( n % 36 / 6 )); APB[i+1]=$(( n % 6 ))
done
for ((i = 0; i <= 100; i++)); do
  a=$(( i / 10 )); b=$(( a < 10 ? a + 1 : a )); f=$(( i - a * 10 ))
  r=$(( (APR[a+1] * 10 + (APR[b+1] - APR[a+1]) * f + 5) / 10 ))
  g=$(( (APG[a+1] * 10 + (APG[b+1] - APG[a+1]) * f + 5) / 10 ))
  bl=$(( (APB[a+1] * 10 + (APB[b+1] - APB[a+1]) * f + 5) / 10 ))
  RAMPX[i+1]=$'\e[38;5;'"$(( 16 + 36 * r + 6 * g + bl ))"'m'
done

rampcol() { # $1=colour-level 0-100 -> SGR on stdout (shared smooth ramp)
  local i=$(( ${1:-0} + 1 )); ((i < 1)) && i=1; ((i > 101)) && i=101
  print -r -- "$RAMPX[i]"
}

rep() { REP=""; local i; for ((i = 0; i < $2; i++)); do REP+=$1; done }

framed() { # $1 = multi-line chart content -> FRAMED (dim rail on every line)
  FRAMED=""
  local row
  while IFS= read -r row; do FRAMED+=" ${C_DIM}│${R}${row}"$'\n'; done <<< "$1"
}

attribute() { # $1 = in_flight_started_s (epoch) -> OpenClaw sessionKey.
  # [model-fetch] start lines are no longer logged (last real one Oct 13),
  # so anchor on [agent-turn-timing] lines (runId+sessionKey, logged
  # throughout a turn): the owner is the turn whose milestone immediately
  # precedes the dispatch. [exec] lines skipped — our own greps get logged
  # and pollute the patterns.
  tail -c 1500000 "$GWLOG" 2>/dev/null | python3 -c '
import sys, re, datetime
t = float(sys.argv[1])
skeys = []
progruns = []
pat = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d+)([+-]\d\d:\d\d) ")
keypat = re.compile(r"^agent:[A-Za-z0-9:_-]+$")
for line in sys.stdin:
    m = pat.match(line)
    if not m:
        continue
    try:
        ts = datetime.datetime.fromisoformat(m.group(1) + m.group(2)).timestamp()
    except Exception:
        continue
    if "[exec]" in line:
        continue
    pm = re.search(r"runId=([a-z][a-z0-9-]*):[0-9a-f-]+", line)
    if pm and "prompt-cache" in line:
        progruns.append((ts, pm.group(1)))
    if "[sessions/lifecycle]" in line and "operation=compaction" in line:
        progruns.append((ts, "compaction"))
    sm = re.search(r"sessionKey=(\S+)", line)
    if sm and keypat.match(sm.group(1)):
        skeys.append((ts, sm.group(1)))
    else:
        lm = re.search(r"lane=session:(agent:[A-Za-z0-9:_-]+)", line)
        if lm and keypat.match(lm.group(1)):
            skeys.append((ts, lm.group(1)))
if not skeys and not progruns:
    sys.exit(0)
pcands = [x for x in progruns if -120 <= (t - x[0]) <= 10]
if pcands:
    print("program:" + max(pcands, key=lambda x: x[0])[1])
    sys.exit(0)
cands = [x for x in skeys if x[0] <= t + 0.5]
if not cands:
    sys.exit(0)
ts, key = max(cands, key=lambda x: x[0])
if t - ts > 300:
    sys.exit(0)
print(key)
' "$1" 2>/dev/null
}

bar() { # $1 fill% (0-100), $2=head colour-level, $3=len -> global BARSTR
  local f=${1:-0}; local n=${3:-16}
  [[ "$f" == <-> ]] || f=0
  (( f < 0 )) && f=0; (( f > 100 )) && f=100
  local fr=$(( (f * n + 50) / 100 )); ((fr > n)) && fr=n
  local e=$(( n - fr ))
  local head=${2:-0}
  BARSTR=""
  local i lv
  for ((i = 1; i <= fr; i++)); do
    lv=$(( head * i / fr ))   # gradient: calm at tail -> current heat at head
    if ((i == fr)); then
      BARSTR+="$(rampcol $lv)${BL}█"
    else
      BARSTR+="$(rampcol $lv)█"
    fi
  done
  BARSTR+=$R
  if ((e > 0)); then rep '░' $e; BARSTR+="${C_BARBG}${REP}${R}"; fi
}

chart() { # $1=plot array (EMA-smoothed used %) $2=colour-src array (RAW used %)
  #          $3=rows $4=width -> CHART ($3 lines)
  # height grows upward with pressure; colour comes from the RAW sample so
  # the chart's right edge always matches the gauge exactly (EMA lag-proof)
  local -a s cs; eval "s=(\"\${(@)$1}\")"; eval "cs=(\"\${(@)$2}\")"
  local rows=$3 width=$4
  local n=${#s}
  if (( n > width )); then s=("${s[-width,-1]}"); cs=("${cs[-width,-1]}"); n=$width; fi
  local off=$((width - n)); ((off < 0)) && off=0
  local T=$((rows * 4)) T2=$((rows - 1))
  local c v0 v1 h0 h1 fill f bits k kl kr r
  local line run runcol col
  CHART=""
  for ((r = 0; r < rows; r++)); do
    line=""
    if ((off > 0)); then rep ' ' $off; line=$REP; fi
    run=""; runcol=""
    for ((c = off + 1; c <= width; c++)); do
      local ci=$((c - off))
      v1=${s[ci]:-0}
      v0=${s[ci > 1 ? ci - 1 : 1]:-0}
      fill=$(( (v1 * T + 50) / 100 )); (( v1 > 0 && fill < 1 )) && fill=1
      h1=$fill
      h0=$(( (v0 * T + 50) / 100 ))
      (( v0 > 0 && h0 < 1 )) && h0=1
      bits=0
      local bb=$(( (T2 - r) * 4 ))
      for ((k = 1; k <= 4; k++)); do
        kl=0; kr=0
        (( bb + k <= h0 )) && kl=1
        (( bb + k <= h1 )) && kr=1
        if ((kl && kr)); then bits=$((bits + PAIR[k]))
        elif ((kl)); then bits=$((bits + LBIT[k]))
        elif ((kr)); then bits=$((bits + RBIT[k])); fi
      done
      col=$(rampcol "${cs[ci]:-$v1}")
      if [[ -n "$runcol" && "$col" != "$runcol" ]]; then
        line+="${runcol}${run}${R}"; run=""
      fi
      run+="${BRAILLE[bits+1]}"; runcol=$col
    done
    [[ -n "$run" ]] && line+="${runcol}${run}${R}"
    CHART+="${line}"$'\n'
  done
}

sparkline() { # ASCII fallback: $1=plot array $2=colour-src array (RAW) $3=cells
  local -a s cs; eval "s=(\"\${(@)$1}\")"; eval "cs=(\"\${(@)$2}\")"
  local need=$3
  local n=${#s}
  local off=$((need - n)); ((off < 0)) && off=0
  local out="" i idx v
  for ((i = 0; i < need; i++)); do
    if ((i < off)); then out+=" "; continue; fi
    idx=$((i - off + 1)); p=${s[idx]:-0}
    out+="$(rampcol "${cs[idx]:-$p}")${SKCH[$((p * 7 / 100 + 1))]}"
  done
  CHART="${out}"$'\n'
}

livejoin() { # $1 = tstart (epoch) -> live OpenClaw sessionKey from the status
  # snapshot (openclaw sessions --active, refreshed in background). Heuristic
  # join: if exactly one session is running, it owns the inference; with
  # several, nearest lastInteraction to the request start.
  python3 -c '
import json, sys
t = float(sys.argv[1])
try:
    d = json.load(open("/tmp/mw-oc-sessions.json"))
except Exception:
    sys.exit(0)
items = d if isinstance(d, list) else d.get("sessions", d.get("items", []))
run = [s for s in items if s.get("status") == "running" and s.get("key")]
if not run:
    sys.exit(0)
if len(run) == 1:
    print(run[0]["key"]); sys.exit(0)
def near(s):
    li = s.get("lastInteractionAt") or s.get("updatedAt") or 0
    return abs(li / 1000.0 - t)
best = min(run, key=near)
if near(best) <= 600:
    print(best["key"])
' "$1" 2>/dev/null
}

while true; do
  read -r LINES COLS <<< "$(stty size 2>/dev/null)"
  [[ -z "$COLS" || "$COLS" -lt 40 ]] && COLS=56
  [[ -z "$LINES" ]] && LINES=24
  [ -n "$MW_COLS" ] && COLS=$MW_COLS
  CW=$((COLS - 2))
  chartw=$((CW - 2))   # framed charts: │ + content must end where gauges end

  freeP=$(memory_pressure -Q 2>/dev/null | grep -oE '[0-9]+%' | tail -1 | tr -d '%')
  [[ "$freeP" == <-> ]] || freeP=50
  pf=$((100 - freeP))                    # PRESSURE = used %

  sf=0; swaplab="none"
  read -r sf swaplab swapUsedM swapTotalM <<< "$(sysctl -n vm.swapusage 2>/dev/null | awk '
    { for (i = 1; i < NF; i++) { if ($i == "total") t = $(i+2); if ($i == "used") u = $(i+2) } }
    END {
      gsub("M", "", t); gsub("M", "", u)
      if (t+0 <= 0) { printf "0 none"; exit }
      p = (u+0) * 100 / (t+0); if (p > 100) p = 100
      printf "%d %.1f/%.1fG %d %d", p, (u+0)/1024, (t+0)/1024, u+0, t+0
    }')"
  [[ "$sf" == <-> ]] || sf=0
  swapUsedM=${swapUsedM:-0}; swapTotalM=${swapTotalM:-0}

  histP+=($pf); histS+=($sf)
  while (( ${#histP} > chartw )); do histP=(${histP[2,-1]}); histS=(${histS[2,-1]}); done

  # display EMA (light smoothing for the CHARTS only; gauge/min/max/avg stay
  # raw). kernel free-memory jitter sawtooths between samples — even a
  # correct plot looks like chaos without it. MW_SMOOTH=0 disables.
  if [[ "$MW_SMOOTH" != 0 ]]; then
    shP=(); prev=-1
    for v in "${(@)histP}"; do
      (( prev < 0 )) && shP+=($v) || shP+=($(( (v + prev) / 2 )))
      prev=${shP[-1]}
    done
    shS=(); prev=-1
    for v in "${(@)histS}"; do
      (( prev < 0 )) && shS+=($v) || shS+=($(( (v + prev) / 2 )))
      prev=${shS[-1]}
    done
  else
    shP=("${(@)histP}"); shS=("${(@)histS}")
  fi

  # Activity-Monitor-style colouring (option C): colour follows GROWTH of
  # pressure, not level — steady usage stays green, sustained rise goes
  # amber, sharp rise red. Absolute floor overrides: free <10% amber,
  # <5% red. Relief (falling) is always green. cpP = per-sample colour
  # level 0-100 feeding the shared ramp; slope = %/min over ~6s, smoothed.
  cpP=(); prevSlope=0
  for ((i = 1; i <= ${#histP}; i++)); do
    freeRaw=$((100 - histP[i]))
    sl=0
    (( i > 3 )) && sl=$(( (shP[i] - shP[i-3]) * 10 ))   # %/min over 3 samples
    (( prevSlope = (sl + prevSlope) / 2 ))
    # smooth: colour level = f(slope %/min over 6s), clamped. Red anchored
    # to Oliver's "50% in 3s": full red ≈ 50 pressure-points in 6s
    # (500%/min), onset 25 points (250%/min), amber everywhere below.
    if (( freeRaw < 5 )); then cpl=100
    elif (( freeRaw < 10 )); then cpl=88
    else
      if (( prevSlope <= 15 )); then cpl=$(( prevSlope * 2 ))
      elif (( prevSlope <= 250 )); then cpl=$(( 30 + (prevSlope - 15) * 50 / 235 ))
      elif (( prevSlope <= 500 )); then cpl=$(( 80 + (prevSlope - 250) * 20 / 250 ))
      else cpl=100
      fi
      (( cpl < 0 )) && cpl=0; (( cpl > 100 )) && cpl=100
    fi
    cpP+=($cpl)
  done
  cpNow=${cpP[-1]:-0}

  # Lag compensation: a backwards 6s window + EMA paints a fast rise ~6s
  # late (colour forms only after the rise is over). Shift colour 2 samples
  # forward so mid-chart colours centre on the shape they describe, and let
  # the edge (gauge + rightmost column) also read a faster 4s slope. Edge
  # colour = max(shifted, fast) keeps gauge & chart right edge identical.
  if (( ${#cpP} > 6 )); then
    cpP=(${cpP[3,-1]} $cpP[-1] $cpP[-1])
  fi
  if (( ${#shP} > 3 )); then
    fnow=$(( (shP[-1] - shP[-3]) * 15 ))      # %/min over 4s
    fcpl=0
    if (( fnow > 0 )); then
      if (( fnow <= 15 )); then fcpl=$(( fnow * 2 ))
      elif (( fnow <= 250 )); then fcpl=$(( 30 + (fnow - 15) * 50 / 235 ))
      elif (( fnow <= 500 )); then fcpl=$(( 80 + (fnow - 250) * 20 / 250 ))
      else fcpl=100
      fi
    fi
    (( fcpl > cpNow )) && cpNow=$fcpl
  fi
  cpP[-1]=$cpNow

  # swap colour: swap used as % of TOTAL RAM (swap capacity is dynamic —
  # 3G swap on a 128G machine is ~2% and calm). amber ~6% of RAM, red ~13%.
  totalRAM_M=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 ))
  cpS=()
  for ((i = 1; i <= ${#histS}; i++)); do
    scl=$(( histS[i] * swapTotalM * 6 / (totalRAM_M > 0 ? totalRAM_M : 1) ))
    (( scl < 0 )) && scl=0; (( scl > 100 )) && scl=100
    cpS+=($scl)
  done
  scNow=${cpS[-1]:-0}

  mn=100 mx=0 sm=0 c=0
  for v in "${(@)histP}"; do ((v<mn))&&mn=$v; ((v>mx))&&mx=$v; sm=$((sm+v)); c=$((c+1)); done
  av=$(( c > 0 ? sm / c : 50 ))
  smin=100 smax=0
  for v in "${(@)histS}"; do ((v<smin))&&smin=$v; ((v>smax))&&smax=$v; done

  winsec=$(( ${#histP} * INTERVAL ))
  la=$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | xargs)
  now=$(date '+%a %d %b %H:%M:%S')

  barlen=$((COLS - 40)); ((barlen < 8)) && barlen=8; ((barlen > 36)) && barlen=36
  bar "$pf" "$cpNow" "$barlen"; pbar=$BARSTR
  bar "$sf" "$scNow" "$barlen"; sbar=$BARSTR

  P_ROWS=4 S_ROWS=2
  ((LINES < 21)) && { P_ROWS=3; S_ROWS=2 }
  ((LINES < 18)) && { P_ROWS=2; S_ROWS=1 }

  if [[ "$MW_ASCII" == 1 ]]; then
    sparkline shP cpP "$chartw"; chartP=${CHART%$'\n'}
    sparkline shS cpS "$chartw"; chartS=${CHART%$'\n'}
  else
    chart shP cpP "$P_ROWS" "$chartw"; chartP=${CHART%$'\n'}
    chart shS cpS "$S_ROWS" "$chartw"; chartS=${CHART%$'\n'}
  fi

  # INFERENCE panel: live mtplx sessions via llama-swap upstreams
  # (:5801 optimized, :5800 bare). Attribution chain: cached label -> log
  # anchors -> live OpenClaw session-status join. Snapshot refreshed in
  # background every ~10s (CLI needs a warm node, ~0.7s per call).
  mkdir -p ~/.cache
  ocage=$(stat -f %m "$OCSNAP" 2>/dev/null || echo 0)
  if (( $(date +%s) - ocage > 10 )); then
    ( /opt/homebrew/bin/openclaw sessions --active 10 --all-agents --json > "$OCSNAP.new" 2>/dev/null && mv "$OCSNAP.new" "$OCSNAP" ) > /dev/null 2>&1 &
  fi
  typeset -a inf_all
  inf_all=()
  INF_UP=0
  UPMODELS=""
  for port in 5801 5800; do
    resp=$(curl -s -m 1 "http://127.0.0.1:$port/admin/sessions" 2>/dev/null)
    [[ -z "$resp" ]] && continue
    INF_UP=$((INF_UP + 1))
    mname=$(curl -s -m 1 "http://127.0.0.1:$port/health" 2>/dev/null | grep -o '"model": *"[^"]*"' | head -1 | cut -d'"' -f4)
    mshort=${mname#mtplx-flash-next-}; mshort=${mshort%%-*}
    [[ -z "$mshort" || "$mshort" == "$mname" ]] && mshort=$([[ $port == 5801 ]] && echo opt || echo bare)
    UPMODELS+="${mshort}+"
    parsed=$(printf '%s' "$resp" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for s in d.get("sessions", []):
    print("\t".join(str(x) for x in [
        s.get("session_id", "?"),
        1 if s.get("in_flight") else 0,
        s.get("in_flight_started_s") or 0,
        s.get("prefix_len") or 0,
        len(s.get("turn_prompt_lens") or []),
        s.get("last_access_s") or 0,
    ]))
' 2>/dev/null)
    while IFS=$'\t' read -r sid infl tstart pfx nturns lastacc; do
      [[ -z "$sid" ]] && continue
      inf_all+=("$port|$sid|$infl|$tstart|$pfx|$nturns|$lastacc")
    done <<< "$parsed"
  done

  INF_N=0; INF_ACT=0
  INF_ROWS=""
  if (( ${#inf_all} )); then
    sorted=$(printf '%s\n' "${(@)inf_all}" | sort -t'|' -k3,3r -k7,7nr | head -4)
    now_s=$(date +%s)
    while IFS='|' read -r port sid infl tstart pfx nturns lastacc; do
      [[ -z "$sid" ]] && continue
      tsuse=$tstart
      [[ -z "$tsuse" || "$tsuse" == 0 ]] && tsuse=$(grep "^$sid|" "$TSMAP" 2>/dev/null | tail -1 | cut -d'|' -f2)
      if (( infl == 1 && ${tstart:-0} > 0 )); then
        grep -v "^$sid|" "$TSMAP" 2>/dev/null > "$TSMAP.n"
        printf '%s|%s\n' "$sid" "$tstart" >> "$TSMAP.n"
        mv "$TSMAP.n" "$TSMAP"
      fi
      label=$(grep "^$sid|" "$INFMAP" 2>/dev/null | tail -1 | cut -d'|' -f2)
      if [[ -z "$label" ]]; then
        label=$(attribute "$tsuse")
        if [[ -z "$label" ]]; then
          label=$(livejoin "$tsuse")
        fi
        if [[ -n "$label" ]]; then
          printf '%s|%s|%s\n' "$sid" "$label" "$now_s" >> "$INFMAP"
        fi
      fi
      [[ -z "$label" ]] && label="unattributed"
      label=${label#agent:}
      label=$(print -r -- "$label" | sed -E 's/([0-9a-f]{8})-[0-9a-f-]+/\1/g')
      label=${label%%[[:space:]]*}; label=${label:0:18}
      pfxk=$(( ${pfx:-0} / 1000 ))
      if (( infl == 1 )); then
        dur=$(( now_s - ${tstart%%.*} )); ((dur < 0)) && dur=0
        INF_ROWS+="${C_ACC}${BL}●${R} ${C_DIM}${sid:5:8}${R} ${C_TXT}${label}${R} ${C_DIM}${pfxk}k ${nturns}t · live $((dur / 60))m$((dur % 60))s${R}"$'\n'
        INF_ACT=$((INF_ACT + 1))
      else
        age=$(( now_s - ${lastacc%%.*} )); ((age < 0)) && age=0
        INF_ROWS+="  ${C_DIM}${sid:5:8} ${label} ${pfxk}k ${nturns}t · $((age / 60))m ago${R}"$'\n'
      fi
      INF_N=$((INF_N + 1))
    done <<< "$sorted"
  fi
  if (( INF_UP == 0 )); then
    INF_HDR=" ${C_DIM}INFERENCE · no mtplx servers up${R}"
    INF_LINES=1
  else
    INF_HDR=" ${C_TXT}${BL}INFERENCE${R} ${C_DIM}${INF_ACT} active · ${INF_N} sess · ${UPMODELS%+} up${R}"
    if (( INF_N > 0 )); then
      framed "${INF_ROWS%$'\n'}"; INF_ROWS="$FRAMED"
      INF_ROWS+=" ${C_DIM}╰${HRULE}${R}"$'\n'
      INF_LINES=$((INF_N + 2))
    else
      INF_LINES=1
    fi
  fi

  rl=$((COLS - 12 - ${#now} - 2)); ((rl < 0)) && rl=0
  rep '─' $rl; RULE=$REP
  rep '─' $chartw; HRULE=$REP

  out=$'\e[H\e[2J'
  out+=" ${C_ACC}${BL}◆ MEMORY${R} ${C_DIM}${RULE}${R} ${now}"$'\n'$'\n'
  out+=" ${C_TXT}${BL}$(printf '%-9s' PRESSURE)${R} $(rampcol $cpNow)${BL}$(printf '%-11s' "${freeP}% free")${R} [${pbar}] ${C_DIM}${mn}-${mx} avg ${av}${R}"$'\n'
  if [[ "$MW_ASCII" == 1 ]]; then
    out+=" $chartP"$'\n'
  else
    framed "$chartP"; out+="$FRAMED"
    out+=" ${C_DIM}╰${HRULE}${R}"$'\n'
  fi
  out+=" ${C_TXT}${BL}$(printf '%-9s' SWAP)${R} $(rampcol $scNow)${BL}$(printf '%-11s' "$swaplab")${R} [${sbar}] ${C_DIM}${smin}-${smax}%${R}"$'\n'
  if [[ "$MW_ASCII" == 1 ]]; then
    out+=" $chartS"$'\n'
  else
    framed "$chartS"; out+="$FRAMED"
    out+=" ${C_DIM}╰${HRULE}${R}"$'\n'
  fi
  out+="$INF_HDR"$'\n'
  out+="$INF_ROWS"
  out+=" ${C_DIM}${winsec}s window · 2s/sample · load ${la}${R}"$'\n'$'\n'

  # TOP: fill remaining screen with top-N processes by phys_footprint (total),
  # showing RSS alongside. footprint = Activity Monitor's Memory column —
  # catches big-foots whose RSS lies (e.g. GPU/wired dirty pages in swap).
  TOP_N=$((LINES - 11 - P_ROWS - S_ROWS - INF_LINES)); ((TOP_N < 5)) && TOP_N=5

  typeset -A PRSS PNAME
  PRSS=() PNAME=()
  local namew=$((COLS - 27)); ((namew < 10)) && namew=10
  while IFS='|' read -r pid rss nm; do
    [[ -z "$pid" ]] && continue
    PRSS[$pid]=$rss; PNAME[$pid]=$nm
  done <<< "$(ps axo pid=,rss=,comm= 2>/dev/null | awk -v nw="$namew" '{pid=$1;rss=$2;n=$0;sub(/^[^ ]+ +[^ ]+ +/,"",n); sub(/^.*\//,"",n); sub(/^-/,"",n); if(length(n)>nw)n=substr(n,1,nw); printf "%s|%s|%s\n",pid,rss,n}')"

  out+=" ${C_DIM}${BL}TOP PROCESSES${R} ${C_DIM}RSS / total footprint${R}"$'\n'
  out+=" ${C_DIM}  #   PID    RSS  TOTAL${R}"$'\n'

  i=1
  while IFS=' ' read -r pid tot; do
    [[ -z "$pid" ]] && continue
    nm=${PNAME[$pid]:-}; [[ -z "$nm" ]] && continue
    r=${PRSS[$pid]:-0}
    if (( r > 1048576 )); then rs=$(printf '%.1fG' $((r / 1048576.0))); else rs=$(printf '%.0fM' $((r / 1024.0))); fi
    out+=" $(printf '%2d' $i) ${C_DIM}$(printf '%6s' $pid)${R} ${C_DIM}$(printf '%6s' $rs)${R} ${C_ACC}$(printf '%6s' $tot)${R}  ${C_TXT}${nm}${R}"$'\n'
    i=$((i + 1)); ((i > TOP_N)) && break
  done <<< "$(top -l 1 -o mem -n 40 -stats pid,mem 2>/dev/null | awk '/^PID/{f=1;next} f && NF>=2 && $1 ~ /^[0-9]+$/ {print $1, $2}')"

  # never end with a newline: writing LINES complete lines in an LINES-row
  # pane scrolls the title off (this ate the header at phone widths)
  printf '%s' "${out%$'\n'}"
  sleep $INTERVAL
done
